{
  "name": "kinematic-tally-connector",
  "version": "0.3.2",
  "description": "Bridge agent that runs alongside Tally Prime on the distributor's PC. Polls Kinematic for pending voucher jobs, posts them to local Tally via HTTP/XML, and reports back the resulting Tally voucher IDs.",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node index.js run",
    "once": "node index.js run --once",
    "check": "node index.js check",
    "test": "node --test test/agent.test.js test/setup.test.js",
    "build:exe": "npx --yes @yao-pkg/pkg@6.5.1 . --targets node20-win-x64 --output dist/kinematic-tally-agent.exe"
  },
  "keywords": [
    "kinematic",
    "tally",
    "erp",
    "distribution",
    "voucher",
    "bridge"
  ],
  "author": "Kinematic",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {},
  "bin": {
    "kinematic-tally-agent": "index.js"
  },
  "pkg": {
    "scripts": [
      "lib/*.js",
      "index.js"
    ],
    "assets": [
      "package.json"
    ]
  }
}
